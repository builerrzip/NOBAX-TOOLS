# NOBAX TOOLS - Environment Configuration
# Salin file ini menjadi .env lalu isi API key Anda sendiri.
# JANGAN PERNAH meng-upload file .env ke GitHub!

NOBAX_PROVIDER=openai
NOBAX_API_KEY=
NOBAX_MODEL=gpt-4o-mini
NOBAX_BASE_URL=https://api.openai.com/v1/chat/completions
NOBAX_STREAM=true

# Opsional: Alternatif environment variable standar
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
